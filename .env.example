# FareFlow environment configuration -- TEMPLATE
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is gitignored. This template is committed on purpose so anyone
# cloning the repo knows which variables are required. Never put real
# credentials in this file.

# JDBC connection string for the FareFlow PostgreSQL database
DB_URL=jdbc:postgresql://localhost:5432/fareflow

# Database role that owns the fareflow database
DB_USERNAME=fareflow

# Password for the role above. No default is provided in application.yml --
# the application fails fast at startup if this is missing.
DB_PASSWORD=

# Port the Spring Boot server listens on
SERVER_PORT=8080
