# FareFlow environment configuration -- TEMPLATE
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is gitignored. This template is committed on purpose so anyone
# cloning the repo knows which variables are required. Never put real
# credentials in this file.

# ---------- Database ----------
DB_URL=jdbc:postgresql://localhost:5432/fareflow
DB_USERNAME=fareflow
# No default in application.yml -- the app fails fast if this is missing.
DB_PASSWORD=

# ---------- Server ----------
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- Authentication ----------
# true  -> real auth: register/login required, identity from JWT
# false -> demo mode: opens straight into the app as the seeded demo user
FAREFLOW_AUTH_ENABLED=true

# Required ONLY when FAREFLOW_AUTH_ENABLED=true. Must be at least 32 bytes.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# Token lifetime in seconds (default 86400 = 24h)
JWT_EXPIRATION=86400
