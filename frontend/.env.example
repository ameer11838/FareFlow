# ---------- API ----------
VITE_API_BASE_URL=http://localhost:8080

# ---------- Authentication ----------
# Must match the backend's FAREFLOW_AUTH_ENABLED.
# The app also asks the server at /api/auth/config and trusts that answer, so a
# mismatch degrades gracefully rather than breaking.
#   true  -> login/register required
#   false -> demo mode, opens straight into the app
VITE_AUTH_ENABLED=true

# ---------- Maps ----------
# Google Maps Platform key, used to render map tiles on the Plan Trip page. The
# backend imports this same file, so this key also backs server-side place
# search. Enable Maps JavaScript API, Places API (New), and Routes API on it.
#
# Without it the Plan Trip page still works: route scoring, recommendations, and
# selection all function, and the map area shows a schematic fallback instead of
# Google tiles. Never commit a real key -- .env is gitignored.
VITE_GOOGLE_MAPS_API_KEY=

# Optional. Advanced markers require a map id; Google's DEMO_MAP_ID is used when
# this is blank. Set a styled id from the Cloud console to theme the basemap.
VITE_GOOGLE_MAPS_MAP_ID=
