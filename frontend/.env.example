# ---------- API ----------
VITE_API_BASE_URL=http://localhost:8080

# ---------- Authentication ----------
# Must match the backend's FAREFLOW_AUTH_ENABLED.
# The app also asks the server at /api/auth/config and trusts that answer, so a
# mismatch degrades gracefully rather than breaking.
#   true  -> login/register required
#   false -> demo mode, opens straight into the app
VITE_AUTH_ENABLED=true

# ---------- Maps ----------
# TomTom Maps SDK key, used only to render map tiles on the Plan Trip page.
# Get one free at https://developer.tomtom.com/ (Maps SDK for Web).
#
# Without it the Plan Trip page still works: route scoring, recommendations, and
# selection all function, and the map area shows a schematic fallback instead of
# TomTom tiles. Never commit a real key -- .env is gitignored.
VITE_TOMTOM_API_KEY=
